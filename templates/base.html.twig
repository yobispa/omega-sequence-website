<!DOCTYPE html>
<html lang="{% block html_lang %}nl{% endblock %}">
<head>
<meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}Omega Sequence &mdash; Beheers DR / IDR & Algoritmische Prijslevering{% endblock %}</title>
  <meta name="description" content="Private mentorship die het Omega Sequence framework leert naast DR / IDR fundamenten. Gebouwd voor serieuze traders." />
  <meta name="theme-color" content="#05060a" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}" />
  <link rel="apple-touch-icon" href="{{ asset('favicon.svg') }}" />
  <link rel="mask-icon" href="{{ asset('favicon.svg') }}" color="#1ee59c" />

  <!-- Canonical -->
  <link rel="canonical" href="https://omegasequence.com/" />

  <!-- Open Graph (Facebook, LinkedIn, Discord, WhatsApp) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Omega Sequence" />
  <meta property="og:locale" content="nl_NL" />
  <meta property="og:locale:alternate" content="en_GB" />
  <meta property="og:url" content="https://omegasequence.com/" />
  <meta property="og:title" content="Omega Sequence — Beheers DR / IDR & Algoritmische Prijslevering" />
  <meta property="og:description" content="Private mentorship die het Omega Sequence framework leert naast DR / IDR fundamenten. Gebouwd voor serieuze traders." />
  <meta property="og:image" content="https://omegasequence.com/assets/og-image.svg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Omega Sequence — handel met het algoritmische leveringsmodel dat de markten echt volgen." />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Omega Sequence — Beheers DR / IDR & Algoritmische Prijslevering" />
  <meta name="twitter:description" content="Private mentorship die het Omega Sequence framework leert naast DR / IDR fundamenten." />
  <meta name="twitter:image" content="https://omegasequence.com/assets/og-image.svg" />

  <!-- Robots -->
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Gio · Omega Sequence" />
  <meta name="keywords" content="Omega Sequence, DR, IDR, trading mentorship, prop firm, ICT, algorithmische levering, Nederlandse trading mentorship" />

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['"Space Grotesk"', 'sans-serif'],
            sans: ['Inter', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            ink: {
              900: '#05060a',
              800: '#0a0b12',
              700: '#11121b',
              600: '#1a1c28',
              500: '#252836',
            },
            omega: {
              50:  '#eafff7',
              100: '#c8ffe9',
              200: '#8effd2',
              300: '#4cf6b8',
              400: '#1ee59c',
              500: '#00c281',
              600: '#009868',
              700: '#007a55',
              800: '#005f43',
              900: '#003b29',
            },
            amber: {
              500: '#f5a524',
              400: '#ffb84d',
            }
          },
          animation: {
            'glow-pulse': 'glowPulse 4s ease-in-out infinite',
            'float-slow': 'floatSlow 8s ease-in-out infinite',
            'shimmer': 'shimmer 3s linear infinite',
            'scroll-x': 'scrollX 40s linear infinite',
          },
          keyframes: {
            glowPulse: {
              '0%,100%': { opacity: 0.5, transform: 'scale(1)' },
              '50%':     { opacity: 0.9, transform: 'scale(1.05)' },
            },
            floatSlow: {
              '0%,100%': { transform: 'translateY(0px)' },
              '50%':     { transform: 'translateY(-12px)' },
            },
            shimmer: {
              '0%':   { backgroundPosition: '-200% 0' },
              '100%': { backgroundPosition: '200% 0' },
            },
            scrollX: {
              '0%':   { transform: 'translateX(0)' },
              '100%': { transform: 'translateX(-50%)' },
            },
          }
        }
      }
    }
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- AOS animation library -->
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

  <!-- Flag icons (for the language dropdown) -->
  <link href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css" rel="stylesheet">

  <!-- Lucide icons -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

  
  {% block stylesheets %}{% endblock %}
  {% block javascripts %}
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    {% block importmap %}{{ importmap('app') }}{% endblock %}
  {% endblock %}
  {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
  {% if frankenphpHotReload %}
    <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
    <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
    <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
  {% endif %}
</head>
<body data-turbo="false" data-page="{% block page_key %}default{% endblock %}" class="bg-ink-900 text-white antialiased font-sans selection:bg-omega-400/30 selection:text-white">
<!-- Background layers -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(30,229,156,0.15),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(245,165,36,0.08),transparent_55%)]"></div>
    <div class="absolute inset-0 grid-bg opacity-[0.18]"></div>
    <div class="noise-overlay"></div>
  </div>


  <!-- NAVBAR -->
  {% set is_landing_page = app.request.attributes.get('_route') == 'landing' %}
  {% set is_dashboard_page = app.request.attributes.get('_route') starts with 'app_dashboard' %}
  {% set landing_url = path('landing') %}
  {% if not is_dashboard_page %}
  <header id="navbar" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 py-2.5 sm:py-4">
      <div class="flex items-center justify-between gap-2 sm:gap-3">
      <a href="{{ path('landing') }}" class="flex min-w-0 items-center gap-2 sm:gap-2.5 group shrink">
        <span class="nav-logo relative inline-flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-xl bg-gradient-to-br from-omega-400 to-omega-600 shadow-lg shadow-omega-500/30 shrink-0">
          <span class="font-display font-bold text-ink-900 text-base sm:text-lg">Ω</span>
        </span>
        <span class="nav-brand-text font-display font-semibold tracking-tight text-base sm:text-lg whitespace-nowrap">Omega Sequence</span>
      </a>

      <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-sm text-white/70">
        <a href="{{ is_landing_page ? '#curriculum' : landing_url ~ '#curriculum' }}" class="hover:text-white transition" data-i18n="nav.curriculum">Curriculum</a>
        <a href="{{ is_landing_page ? '#mentor' : landing_url ~ '#mentor' }}"     class="hover:text-white transition" data-i18n="nav.mentor">Mentor</a>
        <a href="{{ is_landing_page ? '#pricing' : landing_url ~ '#pricing' }}"    class="hover:text-white transition" data-i18n="nav.pricing">Prijzen</a>
        <a href="{{ is_landing_page ? '#faq' : landing_url ~ '#faq' }}"        class="hover:text-white transition" data-i18n="nav.faq">FAQ</a>
        {% if app.user %}
          <a href="{{ path('app_dashboard') }}" class="hover:text-white transition" data-i18n="nav.dashboard">Dashboard</a>
          <a href="{{ path('app_logout') }}" class="hover:text-white transition" data-i18n="nav.logout">Uitloggen</a>
        {% else %}
          <a href="{{ path('app_login') }}" class="hover:text-white transition" data-i18n="nav.login">Inloggen</a>
        {% endif %}
      </nav>

      <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
        <!-- Language dropdown -->
        <div class="relative" id="langSwitcher">
          <button id="langToggle" type="button"
                  class="inline-flex h-9 items-center gap-1.5 sm:gap-2 text-xs font-mono uppercase tracking-wider text-white/85 hover:text-white border border-white/10 hover:border-white/25 bg-white/[0.04] hover:bg-white/[0.08] transition px-2 sm:px-2.5 rounded-lg"
                  aria-haspopup="listbox" aria-expanded="false" aria-label="Taal kiezen">
            <span id="langToggleFlag" class="fi fi-nl rounded-[2px] !h-3.5 !w-5"></span>
            <span id="langToggleLabel">NL</span>
            <i data-lucide="chevron-down" id="langToggleChevron" class="h-3 w-3 transition-transform"></i>
          </button>

          <div id="langMenu"
               class="hidden absolute right-0 mt-2 w-40 rounded-xl border border-white/10 bg-ink-800/95 backdrop-blur shadow-2xl shadow-black/50 overflow-hidden z-50"
               role="listbox" aria-label="Talen">
            <button data-lang="nl" class="lang-option w-full flex items-center gap-3 px-3 py-2.5 text-sm text-white/85 hover:bg-white/[0.06] transition">
              <span class="fi fi-nl rounded-[2px] !h-3.5 !w-5"></span>
              <span class="font-medium">Nederlands</span>
              <i data-lucide="check" class="lang-check h-4 w-4 ml-auto text-omega-300"></i>
            </button>
            <div class="h-px bg-white/5"></div>
            <button data-lang="en" class="lang-option w-full flex items-center gap-3 px-3 py-2.5 text-sm text-white/85 hover:bg-white/[0.06] transition">
              <span class="fi fi-gb rounded-[2px] !h-3.5 !w-5"></span>
              <span class="font-medium">English</span>
              <i data-lucide="check" class="lang-check h-4 w-4 ml-auto text-omega-300 invisible"></i>
            </button>
          </div>
        </div>

        <!-- Whop link goes here later; for now scrolls to pricing -->
        <a href="{{ is_landing_page ? '#pricing' : landing_url ~ '#pricing' }}" class="nav-enroll inline-flex h-9 items-center justify-center gap-1.5 sm:gap-2 text-xs sm:text-sm font-medium bg-white text-ink-900 hover:bg-omega-300 transition px-3 sm:px-4 rounded-lg shadow-lg shadow-black/30" aria-label="Inschrijven" data-i18n-aria-label="nav.enroll">
          <span class="nav-enroll-text" data-i18n="nav.enroll">Inschrijven</span>
          <i data-lucide="arrow-right" class="h-3.5 w-3.5 sm:h-4 sm:w-4"></i>
        </a>
        <button id="mobileMenuToggle" type="button"
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 bg-white/[0.04] text-white/85 hover:border-white/25 hover:bg-white/[0.08] hover:text-white transition lg:hidden"
                aria-controls="mobileMenu" aria-expanded="false" aria-label="Menu" data-i18n-aria-label="nav.menu">
          <i data-lucide="menu" id="mobileMenuIconOpen" class="h-4 w-4"></i>
          <i data-lucide="x" id="mobileMenuIconClose" class="hidden h-4 w-4"></i>
        </button>
      </div>
      </div>

      <div id="mobileMenu" class="hidden lg:hidden mt-3 rounded-2xl border border-white/10 bg-ink-800/95 p-2 shadow-2xl shadow-black/45 backdrop-blur">
        <nav class="grid gap-1 text-sm">
          <a href="{{ is_landing_page ? '#curriculum' : landing_url ~ '#curriculum' }}" class="rounded-xl px-4 py-3 text-white/75 hover:bg-white/[0.06] hover:text-white transition" data-i18n="nav.curriculum">Curriculum</a>
          <a href="{{ is_landing_page ? '#mentor' : landing_url ~ '#mentor' }}" class="rounded-xl px-4 py-3 text-white/75 hover:bg-white/[0.06] hover:text-white transition" data-i18n="nav.mentor">Mentor</a>
          <a href="{{ is_landing_page ? '#pricing' : landing_url ~ '#pricing' }}" class="rounded-xl px-4 py-3 text-white/75 hover:bg-white/[0.06] hover:text-white transition" data-i18n="nav.pricing">Prijzen</a>
          <a href="{{ is_landing_page ? '#faq' : landing_url ~ '#faq' }}" class="rounded-xl px-4 py-3 text-white/75 hover:bg-white/[0.06] hover:text-white transition" data-i18n="nav.faq">FAQ</a>
          {% if app.user %}
            <a href="{{ path('app_dashboard') }}" class="rounded-xl px-4 py-3 text-white/75 hover:bg-white/[0.06] hover:text-white transition" data-i18n="nav.dashboard">Dashboard</a>
            <a href="{{ path('app_logout') }}" class="rounded-xl px-4 py-3 text-white/75 hover:bg-white/[0.06] hover:text-white transition" data-i18n="nav.logout">Uitloggen</a>
          {% else %}
            <a href="{{ path('app_login') }}" class="rounded-xl px-4 py-3 text-white/75 hover:bg-white/[0.06] hover:text-white transition" data-i18n="nav.login">Inloggen</a>
          {% endif %}
          <a href="{{ is_landing_page ? '#pricing' : landing_url ~ '#pricing' }}" class="mt-1 inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-br from-omega-300 to-omega-500 px-4 py-3 font-semibold text-ink-900 transition hover:shadow-lg hover:shadow-omega-400/30">
            <span data-i18n="nav.enroll">Inschrijven</span>
            <i data-lucide="arrow-right" class="h-4 w-4"></i>
          </a>
        </nav>
      </div>
    </div>
  </header>
  {% endif %}
  {% block body %}{% endblock %}
  <!-- FOOTER -->
  {% if not is_dashboard_page %}
  <footer class="border-t border-white/10 py-12">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-omega-400 to-omega-600">
          <span class="font-display font-bold text-ink-900">Ω</span>
        </span>
        <span class="font-display font-semibold tracking-tight">Omega Sequence</span>
      </div>

      <div class="text-sm text-white/40" data-i18n="footer.copy">© 2026 Omega Sequence. Trading brengt risico's met zich mee. Resultaten uit het verleden zijn geen garantie voor de toekomst.</div>

      <div class="flex items-center gap-4 text-white/50">
        <a href="#" class="hover:text-white transition"><i data-lucide="twitter" class="h-4 w-4"></i></a>
        <a href="#" class="hover:text-white transition"><i data-lucide="youtube" class="h-4 w-4"></i></a>
        <a href="#" class="hover:text-white transition"><i data-lucide="instagram" class="h-4 w-4"></i></a>
      </div>
    </div>
  </footer>
  {% endif %}

  <!-- GDPR Cookie consent banner -->
  {% if not is_dashboard_page %}
  <div id="cookieBanner"
       class="hidden fixed bottom-0 inset-x-0 z-[80] px-4 pb-4 sm:px-6 sm:pb-6"
       role="dialog" aria-live="polite" aria-labelledby="cookieTitle">
    <div class="max-w-3xl mx-auto rounded-2xl border border-omega-400/20 bg-ink-800/95 backdrop-blur shadow-2xl shadow-black/60 p-5 sm:p-6">
      <div class="flex items-start gap-3 sm:gap-4">
        <span class="inline-flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl bg-omega-500/15 border border-omega-500/30 shrink-0">
          <i data-lucide="cookie" class="h-4 w-4 sm:h-5 sm:w-5 text-omega-300"></i>
        </span>
        <div class="flex-1 min-w-0">
          <h3 id="cookieTitle" class="font-display font-semibold text-base sm:text-lg" data-i18n="cookie.title">We respecteren je privacy</h3>
          <p class="mt-1.5 text-sm text-white/65 leading-relaxed" data-i18n="cookie.body">
            We gebruiken alleen essentiële cookies om de site te laten werken. Met jouw toestemming gebruiken we anonieme analyses om de site te verbeteren. Je keuze is op elk moment in te trekken.
          </p>
          <div class="mt-4 flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-end">
            <button id="cookieNecessary" type="button"
                    class="inline-flex items-center justify-center px-4 py-2 rounded-lg border border-white/15 hover:bg-white/[0.06] text-sm font-medium text-white/80 hover:text-white transition"
                    data-i18n="cookie.necessary">Alleen noodzakelijk</button>
            <button id="cookieAccept" type="button"
                    class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-gradient-to-r from-omega-300 to-omega-500 text-ink-900 text-sm font-semibold hover:shadow-lg hover:shadow-omega-400/30 transition"
                    data-i18n="cookie.accept">Alles accepteren</button>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% endif %}
</body>
</html>

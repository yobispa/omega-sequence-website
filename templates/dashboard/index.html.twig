{% extends 'base.html.twig' %}

{% block title %}Quant Database | Omega Sequence{% endblock %}
{% block page_key %}dashboard{% endblock %}

{% block body %}
  <main class="omega-dashboard min-h-screen">
    <aside class="dashboard-sidebar fixed inset-y-0 left-0 z-40 hidden w-72 border-r border-white/10 bg-ink-900/92 backdrop-blur-xl lg:flex lg:flex-col">
      <div class="flex h-16 items-center gap-3 border-b border-white/10 px-5">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-omega-300 to-omega-600 shadow-lg shadow-omega-500/25">
          <span class="font-display font-bold text-ink-900">Î©</span>
        </span>
        <div>
          <div class="font-display font-semibold leading-tight">Omega Sequence</div>
          <div class="text-[11px] uppercase tracking-[0.18em] text-white/35 font-mono">Quant database</div>
        </div>
      </div>

      <nav class="flex-1 space-y-1 px-3 py-5 text-sm">
        <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3 rounded-xl bg-omega-500/10 px-3 py-2.5 text-omega-200 ring-1 ring-omega-400/20">
          <i data-lucide="layout-dashboard" class="h-4 w-4"></i>
          Overview
        </a>
        <a href="#pairs" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-white/60 transition hover:bg-white/[0.05] hover:text-white">
          <i data-lucide="database" class="h-4 w-4"></i>
          Pair library
        </a>
        <a href="#session-map" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-white/60 transition hover:bg-white/[0.05] hover:text-white">
          <i data-lucide="candlestick-chart" class="h-4 w-4"></i>
          Session map
        </a>
        <a href="#read-only" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-white/60 transition hover:bg-white/[0.05] hover:text-white">
          <i data-lucide="lock-keyhole" class="h-4 w-4"></i>
          Read-only access
        </a>
      </nav>

      <div class="border-t border-white/10 p-4">
        <div class="rounded-2xl border border-white/10 bg-white/[0.035] p-4">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-omega-500/10 text-omega-300 ring-1 ring-omega-400/20">
              <i data-lucide="user-round" class="h-4 w-4"></i>
            </span>
            <div class="min-w-0">
              <div class="truncate text-sm font-medium">{{ app.user.preferredName }}</div>
              <div class="truncate text-xs text-white/40">{{ app.user.email }}</div>
            </div>
          </div>
          <a href="{{ path('app_logout') }}" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 px-3 py-2 text-sm text-white/65 transition hover:bg-white/[0.06] hover:text-white">
            <i data-lucide="log-out" class="h-4 w-4"></i>
            Logout
          </a>
        </div>
      </div>
    </aside>

    <div class="lg:pl-72">
      <header class="sticky top-0 z-30 border-b border-white/10 bg-ink-900/82 backdrop-blur-xl">
        <div class="flex min-h-16 items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
          <div class="flex items-center gap-3 lg:hidden">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-omega-300 to-omega-600 text-ink-900">
              <span class="font-display font-bold">Î©</span>
            </span>
            <div>
              <div class="font-display font-semibold">Quant DB</div>
              <div class="text-[10px] uppercase tracking-[0.18em] text-white/35 font-mono">Omega</div>
            </div>
          </div>

          <div class="hidden lg:block">
            <div class="text-xs uppercase tracking-[0.2em] text-white/35 font-mono">User workspace</div>
            <div class="mt-1 text-sm text-white/65">Pair datasets are view-only for traders.</div>
          </div>

          <div class="flex items-center gap-2">
            <span class="hidden sm:inline-flex items-center gap-2 rounded-full border border-omega-400/25 bg-omega-500/10 px-3 py-2 text-xs text-omega-200 font-mono">
              <i data-lucide="shield-check" class="h-3.5 w-3.5"></i>
              {{ app.user.membershipTier|title }}
            </span>
            <a href="{{ path('landing') }}" class="inline-flex h-9 items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] px-3 text-sm text-white/70 transition hover:bg-white/[0.08] hover:text-white">
              <i data-lucide="home" class="h-4 w-4"></i>
              <span class="hidden sm:inline">Site</span>
            </a>
          </div>
        </div>
      </header>

      <div class="px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <section class="grid gap-5 xl:grid-cols-[1.2fr_0.8fr]">
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 shadow-2xl shadow-black/25">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
              <div>
                <span class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-omega-300 font-mono">
                  <i data-lucide="radar" class="h-3.5 w-3.5"></i>
                  QuantX-style database
                </span>
                <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
                  Pair intelligence for <span class="bg-gradient-to-br from-omega-300 to-omega-500 bg-clip-text text-transparent">{{ app.user.preferredName }}</span>
                </h1>
                <p class="mt-4 max-w-2xl text-sm leading-relaxed text-white/55 sm:text-base">
                  Browse published historical pair datasets, session context, and Omega Sequence preparation. Uploads stay controlled by mentor/admin through the source folders.
                </p>
              </div>
              <div class="rounded-2xl border border-omega-400/20 bg-omega-500/10 p-4">
                <div class="flex items-center gap-3">
                  <i data-lucide="folder-lock" class="h-5 w-5 text-omega-300"></i>
                  <div>
                    <div class="text-sm font-medium text-omega-100">Read-only mode</div>
                    <div class="mt-1 text-xs text-white/45">Users can view data, not create pairs.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-2">
            {% for stat in workspace_stats %}
              <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 shadow-xl shadow-black/20">
                <div class="flex items-center justify-between gap-3">
                  <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-omega-400/20 bg-omega-500/10 text-omega-300">
                    <i data-lucide="{{ stat.icon }}" class="h-4 w-4"></i>
                  </span>
                  <span class="text-[10px] uppercase tracking-[0.18em] text-white/35 font-mono">Live shell</span>
                </div>
                <div class="mt-4 font-display text-2xl font-semibold">{{ stat.value }}</div>
                <div class="mt-1 text-sm font-medium text-white/80">{{ stat.label }}</div>
                <p class="mt-1 text-xs text-white/42">{{ stat.meta }}</p>
              </article>
            {% endfor %}
          </div>
        </section>

        <section id="pairs" class="mt-6 grid gap-6 xl:grid-cols-[340px_1fr]">
          <aside class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 shadow-2xl shadow-black/25">
            <div class="flex items-center justify-between gap-3">
              <div>
                <h2 class="font-display text-xl font-semibold">Pair library</h2>
                <p class="mt-1 text-xs text-white/45">Mentor-published sources.</p>
              </div>
              <i data-lucide="search" class="h-4 w-4 text-white/35"></i>
            </div>

            <div class="mt-4 space-y-2">
              {% for pair in dataset_pairs %}
                <button type="button" class="dashboard-pair-row w-full rounded-xl border px-3 py-3 text-left transition {{ loop.first ? 'border-omega-400/30 bg-omega-500/10' : 'border-white/8 bg-white/[0.025] hover:border-white/15 hover:bg-white/[0.05]' }}">
                  <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                      <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-ink-800 text-omega-300 ring-1 ring-white/10">
                        <i data-lucide="chart-candlestick" class="h-4 w-4"></i>
                      </span>
                      <div>
                        <div class="font-display font-semibold">{{ pair.symbol }}</div>
                        <div class="mt-0.5 text-xs text-white/40">{{ pair.market }}</div>
                      </div>
                    </div>
                    <span class="rounded-full border border-white/10 px-2 py-1 text-[10px] uppercase tracking-wider text-white/45 font-mono">{{ pair.status }}</span>
                  </div>
                </button>
              {% endfor %}
            </div>
          </aside>

          <section class="rounded-2xl border border-white/10 bg-white/[0.03] shadow-2xl shadow-black/25">
            <div class="border-b border-white/10 p-5">
              <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div>
                  <div class="flex flex-wrap items-center gap-3">
                    <h2 class="font-display text-3xl font-semibold">{{ selected_pair.symbol }}</h2>
                    <span class="rounded-full border border-omega-400/25 bg-omega-500/10 px-3 py-1 text-xs text-omega-200">{{ selected_pair.status }}</span>
                  </div>
                  <p class="mt-2 text-sm text-white/50">{{ selected_pair.market }} dataset view from <span class="font-mono text-white/70">{{ selected_pair.source }}</span></p>
                </div>
                <div class="flex flex-wrap gap-2">
                  <span class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 text-xs text-white/60">
                    <i data-lucide="eye" class="h-3.5 w-3.5 text-omega-300"></i>
                    View only
                  </span>
                  <span class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 text-xs text-white/60">
                    <i data-lucide="refresh-cw" class="h-3.5 w-3.5 text-omega-300"></i>
                    {{ selected_pair.last_update }}
                  </span>
                </div>
              </div>
            </div>

            <div class="grid gap-4 p-5 md:grid-cols-4">
              <div class="rounded-xl border border-white/10 bg-ink-800/55 p-4">
                <div class="text-xs uppercase tracking-[0.16em] text-white/35 font-mono">Coverage</div>
                <div class="mt-3 text-lg font-display font-semibold">{{ selected_pair.coverage }}</div>
              </div>
              <div class="rounded-xl border border-white/10 bg-ink-800/55 p-4">
                <div class="text-xs uppercase tracking-[0.16em] text-white/35 font-mono">Timeframes</div>
                <div class="mt-3 text-lg font-display font-semibold">{{ selected_pair.timeframes }}</div>
              </div>
              <div class="rounded-xl border border-white/10 bg-ink-800/55 p-4">
                <div class="text-xs uppercase tracking-[0.16em] text-white/35 font-mono">Sessions</div>
                <div class="mt-3 text-lg font-display font-semibold">{{ selected_pair.sessions }}</div>
              </div>
              <div class="rounded-xl border border-white/10 bg-ink-800/55 p-4">
                <div class="text-xs uppercase tracking-[0.16em] text-white/35 font-mono">Rows</div>
                <div class="mt-3 text-lg font-display font-semibold">{{ selected_pair.records }}</div>
              </div>
            </div>

            <div class="grid gap-4 p-5 pt-0 lg:grid-cols-[1.25fr_0.75fr]">
              <div class="rounded-xl border border-white/10 bg-ink-800/55 p-4" id="session-map">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="font-display text-xl font-semibold">Session distribution</h3>
                  <i data-lucide="bar-chart-3" class="h-4 w-4 text-omega-300"></i>
                </div>
                <div class="mt-5 space-y-4">
                  {% for row in [
                    { label: 'Asia range', width: '28%', value: 'Pending' },
                    { label: 'London expansion', width: '54%', value: 'Pending' },
                    { label: 'NY AM delivery', width: '72%', value: 'Pending' },
                    { label: 'PM continuation', width: '38%', value: 'Pending' }
                  ] %}
                    <div>
                      <div class="flex items-center justify-between text-xs text-white/45">
                        <span>{{ row.label }}</span>
                        <span>{{ row.value }}</span>
                      </div>
                      <div class="mt-2 h-2 overflow-hidden rounded-full bg-white/[0.06]">
                        <div class="h-full rounded-full bg-gradient-to-r from-omega-400 to-omega-600" style="width: {{ row.width }}"></div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>

              <div class="rounded-xl border border-white/10 bg-ink-800/55 p-4" id="read-only">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="font-display text-xl font-semibold">Access rules</h3>
                  <i data-lucide="shield" class="h-4 w-4 text-omega-300"></i>
                </div>
                <div class="mt-5 space-y-3 text-sm">
                  <div class="flex items-start gap-3 rounded-lg bg-white/[0.03] p-3">
                    <i data-lucide="check-circle-2" class="mt-0.5 h-4 w-4 text-omega-300"></i>
                    <span class="text-white/65">Users can inspect published pair data and session context.</span>
                  </div>
                  <div class="flex items-start gap-3 rounded-lg bg-white/[0.03] p-3">
                    <i data-lucide="lock-keyhole" class="mt-0.5 h-4 w-4 text-omega-300"></i>
                    <span class="text-white/65">Pair creation and file uploads are reserved for mentor/admin flows.</span>
                  </div>
                  <div class="flex items-start gap-3 rounded-lg bg-white/[0.03] p-3">
                    <i data-lucide="folder-cog" class="mt-0.5 h-4 w-4 text-omega-300"></i>
                    <span class="text-white/65">Source data is staged under <span class="font-mono text-white/85">assets/pairs</span>.</span>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </section>

        <section class="mt-6 grid gap-6 xl:grid-cols-[1fr_360px]">
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 shadow-2xl shadow-black/25">
            <div class="flex items-center justify-between gap-3">
              <div>
                <h2 class="font-display text-2xl font-semibold">Published data preview</h2>
                <p class="mt-1 text-sm text-white/45">This table becomes populated once mentor datasets are imported.</p>
              </div>
              <i data-lucide="table-2" class="h-5 w-5 text-omega-300"></i>
            </div>
            <div class="mt-5 overflow-hidden rounded-xl border border-white/10">
              <div class="grid grid-cols-[0.8fr_0.8fr_0.8fr_0.8fr_1fr] bg-white/[0.035] px-4 py-3 text-xs uppercase tracking-[0.16em] text-white/35 font-mono">
                <span>Date</span>
                <span>Session</span>
                <span>Range</span>
                <span>Bias</span>
                <span class="text-right">Omega phase</span>
              </div>
              {% for row in 1..4 %}
                <div class="grid grid-cols-[0.8fr_0.8fr_0.8fr_0.8fr_1fr] border-t border-white/8 px-4 py-4 text-sm text-white/45">
                  <span>Awaiting data</span>
                  <span>-</span>
                  <span>-</span>
                  <span>{{ selected_pair.bias }}</span>
                  <span class="text-right">Not published</span>
                </div>
              {% endfor %}
            </div>
          </div>

          <aside class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 shadow-2xl shadow-black/25">
            <h2 class="font-display text-2xl font-semibold">Build log</h2>
            <div class="mt-5 space-y-4">
              {% for item in activity_items %}
                <div class="flex gap-3">
                  <span class="mt-1 h-2 w-2 rounded-full bg-omega-300 shadow-[0_0_16px_rgba(76,246,184,0.55)]"></span>
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-sm font-medium text-white/85">{{ item.title }}</span>
                      <span class="text-xs text-white/35 font-mono">{{ item.time }}</span>
                    </div>
                    <p class="mt-1 text-sm text-white/45">{{ item.detail }}</p>
                  </div>
                </div>
              {% endfor %}
            </div>
          </aside>
        </section>
      </div>
    </div>
  </main>
{% endblock %}

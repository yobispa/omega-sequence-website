{% extends 'dashboard/base.html.twig' %}

{% block title %}Videos & Chart Proof | Omega Sequence{% endblock %}

{% block dashboard_content %}
  <div
    data-lesson-progress
    data-phase-id="{{ current_phase.number }}"
    data-user-id="{{ app.user.id }}"
    data-required-examples="{{ current_phase.examples_required }}"
    data-completed-lessons="{{ completed_lesson_ids|json_encode|e('html_attr') }}"
    data-progress-endpoint="{{ path('app_dashboard_lesson_completion', { lessonId: '__LESSON_ID__' }) }}"
    data-progress-token="{{ csrf_token('lesson_progress') }}"
  >
    <section class="grid gap-5 xl:grid-cols-[1.12fr_0.88fr]">
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 shadow-2xl shadow-black/25">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-omega-300">
              <i data-lucide="play-square" class="h-3.5 w-3.5"></i>
              Phase {{ current_phase.number }} workspace
            </span>
            <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
              Videos first, then chart proof.
            </h1>
            <p class="mt-4 max-w-2xl text-sm leading-relaxed text-white/55 sm:text-base">
              Mark each lesson finished as you complete it. When every video is completed, the 15 chart-example proof unlocks for this phase.
            </p>
          </div>

          <a href="{{ path('app_dashboard_route_path') }}" class="inline-flex w-fit items-center justify-center gap-2 rounded-xl border border-omega-400/25 bg-omega-500/10 px-4 py-3 text-sm font-medium text-omega-100 transition hover:bg-omega-500/15">
            <i data-lucide="route" class="h-4 w-4"></i>
            View route path
          </a>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 shadow-xl shadow-black/20">
          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-omega-400/20 bg-omega-500/10 text-omega-300">
              <i data-lucide="check-circle-2" class="h-4 w-4"></i>
            </span>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-white/35">Lessons</span>
          </div>
          <div class="mt-4 font-display text-2xl font-semibold" data-video-progress-label>0 / {{ lesson_count }}</div>
          <div class="mt-1 text-sm font-medium text-white/80">Videos completed</div>
        </article>
        <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 shadow-xl shadow-black/20">
          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-omega-400/20 bg-omega-500/10 text-omega-300">
              <i data-lucide="images" class="h-4 w-4"></i>
            </span>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-white/35">Proof</span>
          </div>
          <div class="mt-4 font-display text-2xl font-semibold" data-chart-progress-label>0 / {{ current_phase.examples_required }}</div>
          <div class="mt-1 text-sm font-medium text-white/80">Chart examples</div>
        </article>
        <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 shadow-xl shadow-black/20">
          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-omega-400/20 bg-omega-500/10 text-omega-300">
              <i data-lucide="badge-help" class="h-4 w-4"></i>
            </span>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-white/35">Assessment</span>
          </div>
          <div class="mt-4 font-display text-2xl font-semibold" data-assessment-status-label>Pending</div>
          <div class="mt-1 text-sm font-medium text-white/80">Phase quiz</div>
        </article>
        <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 shadow-xl shadow-black/20">
          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-omega-400/20 bg-omega-500/10 text-omega-300">
              <i data-lucide="route" class="h-4 w-4"></i>
            </span>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-white/35">Unlock</span>
          </div>
          <div class="mt-4 font-display text-2xl font-semibold" data-phase-status-label>Locked</div>
          <div class="mt-1 text-sm font-medium text-white/80">Next phase</div>
        </article>
      </div>
    </section>

    <section id="lesson-player" class="mt-6 rounded-2xl border border-white/10 bg-white/[0.03] p-5 shadow-2xl shadow-black/25">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-omega-300">
            <i data-lucide="video" class="h-3.5 w-3.5"></i>
            Video lessons
          </span>
          <h2 class="mt-2 font-display text-2xl font-semibold">Complete every lesson in Phase {{ current_phase.number }}</h2>
        </div>
        <div class="min-w-[12rem]">
          <div class="flex items-center justify-between font-mono text-xs text-white/40">
            <span>Video progress</span>
            <span data-video-progress-small>0%</span>
          </div>
          <div class="mt-2 h-2 overflow-hidden rounded-full bg-white/[0.07]">
            <div class="h-full rounded-full bg-gradient-to-r from-omega-300 to-omega-600 transition-all duration-300" style="width: 0%" data-video-progress-bar></div>
          </div>
        </div>
      </div>

      <div class="mt-6 grid gap-4 xl:grid-cols-[1fr_330px]">
        <article class="rounded-2xl border border-white/10 bg-ink-800/55 p-4">
          <div class="lesson-player relative overflow-hidden rounded-xl border border-white/10 bg-[#020307] shadow-xl shadow-black/30" data-lesson-player>
            <div class="aspect-video min-h-[220px]">
              <video
                class="h-full w-full bg-black object-cover"
                preload="metadata"
                controls
                controlsList="nodownload noplaybackrate noremoteplayback"
                disablePictureInPicture
                data-lesson-video
              ></video>

              <div class="absolute inset-0 grid place-items-center bg-[radial-gradient(circle_at_center,rgba(30,229,156,0.12),rgba(2,3,7,0.9)_58%)] px-5 text-center" data-focused-lesson-ready>
                <div class="max-w-md">
                  <span class="mx-auto inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-omega-400/25 bg-omega-500/10 text-omega-300">
                    <i data-lucide="play" class="h-6 w-6 fill-current"></i>
                  </span>
                  <h3 class="mt-5 font-display text-2xl font-semibold" data-focused-lesson-title>{{ video_lessons[0].title }}</h3>
                  <p class="mt-2 font-mono text-xs text-white/40" data-focused-lesson-meta>{{ video_lessons[0].phase }} / {{ video_lessons[0].duration }}</p>
                </div>
              </div>

              <div class="absolute inset-0 hidden place-items-center bg-black px-5 text-center" data-focused-lesson-locked>
                <div class="max-w-sm">
                  <span class="mx-auto inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] text-white/45">
                    <i data-lucide="lock" class="h-6 w-6"></i>
                  </span>
                  <h3 class="mt-5 font-display text-2xl font-semibold">Lesson locked</h3>
                  <p class="mt-2 text-sm leading-relaxed text-white/50" data-focused-lock-copy>Mark the previous video finished to unlock this lesson.</p>
                </div>
              </div>

              <div class="absolute inset-0 hidden place-items-center bg-black px-5 text-center" data-protection-veil>
                <div>
                  <i data-lucide="pause-circle" class="mx-auto h-10 w-10 text-omega-300"></i>
                  <div class="mt-4 font-display text-xl font-semibold">Lesson paused</div>
                  <p class="mt-2 max-w-sm text-sm text-white/50">Return to the lesson window to continue.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div class="min-w-0">
              <div class="font-display text-xl font-semibold" data-focused-lesson-heading>{{ video_lessons[0].title }}</div>
              <div class="mt-1 flex flex-wrap items-center gap-2 font-mono text-xs text-white/38">
                <span data-focused-lesson-phase>{{ video_lessons[0].phase }}</span>
                <span data-focused-lesson-duration>{{ video_lessons[0].duration }}</span>
                <span data-focused-lesson-state>Not finished</span>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <button type="button" data-prev-lesson-button class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] px-3 text-sm text-white/65 transition hover:bg-white/[0.08] hover:text-white">
                <i data-lucide="chevron-left" class="h-4 w-4"></i>
                Previous
              </button>
              <button type="button" data-next-lesson-button class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] px-3 text-sm text-white/65 transition hover:bg-white/[0.08] hover:text-white">
                Next
                <i data-lucide="chevron-right" class="h-4 w-4"></i>
              </button>
              <button type="button" data-lesson-complete-button class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] px-4 text-sm font-medium text-white/70 transition hover:bg-white/[0.08] hover:text-white">
                <i data-lucide="circle" class="h-4 w-4" data-lesson-button-icon></i>
                <span data-lesson-button-label>Mark finished</span>
              </button>
            </div>
          </div>
        </article>

        <aside class="rounded-2xl border border-white/10 bg-ink-800/55 p-4">
          <div class="flex items-center justify-between gap-3">
            <div>
              <h3 class="font-display text-xl font-semibold">Lesson tabs</h3>
              <p class="mt-1 text-sm text-white/45">Open one lesson at a time.</p>
            </div>
            <i data-lucide="list-video" class="h-5 w-5 text-omega-300"></i>
          </div>

          <div class="mt-4 space-y-2">
            {% for lesson in video_lessons %}
              <button
                type="button"
                data-lesson-card
                data-lesson-index="{{ loop.index0 }}"
                data-lesson-id="{{ lesson.id }}"
                data-lesson-title="{{ lesson.title|e('html_attr') }}"
                data-lesson-phase="{{ lesson.phase|e('html_attr') }}"
                data-lesson-duration="{{ lesson.duration|e('html_attr') }}"
                class="w-full rounded-xl border border-white/10 bg-white/[0.025] px-3 py-3 text-left transition hover:border-white/15 hover:bg-white/[0.05]"
              >
                <div class="flex items-start gap-3">
                  <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-ink-900 text-white/45 ring-1 ring-white/10" data-lesson-tab-icon-shell>
                    <i data-lucide="lock" class="h-4 w-4" data-lesson-tab-icon></i>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-medium text-white/85">{{ lesson.title }}</span>
                    <span class="mt-1 flex flex-wrap items-center gap-2 font-mono text-xs text-white/38">
                      <span>{{ lesson.phase }}</span>
                      <span>{{ lesson.duration }}</span>
                      <span data-lesson-state-label>Locked</span>
                    </span>
                  </span>
                </div>
              </button>
            {% endfor %}
          </div>
        </aside>
      </div>
    </section>

    <section id="chart-proof" class="mt-6 grid gap-6 xl:grid-cols-[1fr_360px]">
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 shadow-2xl shadow-black/25" data-chart-proof-gate>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-omega-300">
              <i data-lucide="images" class="h-3.5 w-3.5"></i>
              Chart proof
            </span>
            <h2 class="mt-2 font-display text-2xl font-semibold">Upload 15 chart examples</h2>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/50" data-chart-proof-help>
              Complete all phase videos to unlock the chart-example upload step.
            </p>
          </div>
          <div class="rounded-xl border border-omega-400/20 bg-omega-500/10 px-4 py-3">
            <div class="font-mono text-xs uppercase tracking-[0.16em] text-omega-200">Progress</div>
            <div class="mt-1 font-display text-xl font-semibold" data-chart-count-label>0 / {{ current_phase.examples_required }}</div>
          </div>
        </div>

        <div class="mt-6 grid gap-4 lg:grid-cols-[0.72fr_1fr]">
          <div class="rounded-2xl border border-dashed border-white/15 bg-white/[0.025] p-5 text-center transition" data-upload-card>
            <span class="mx-auto inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] text-white/35 transition" data-upload-icon-shell>
              <i data-lucide="lock" class="h-6 w-6" data-upload-icon></i>
            </span>
            <h3 class="mt-4 font-display text-xl font-semibold" data-upload-title>Locked until videos are done</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/50" data-upload-copy>
              The upload step opens automatically after every lesson has been marked completed.
            </p>
            <input type="file" accept="image/*" multiple class="hidden" data-chart-proof-input disabled>
            <button type="button" disabled data-chart-proof-button class="mt-5 inline-flex cursor-not-allowed items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] px-4 py-2.5 text-sm text-white/35 transition">
              <i data-lucide="lock" class="h-4 w-4" data-chart-proof-button-icon></i>
              <span data-chart-proof-button-label>Complete videos first</span>
            </button>
          </div>

          <div class="rounded-2xl border border-white/10 bg-ink-800/55 p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-display text-xl font-semibold">Chart checklist</h3>
              <span class="font-mono text-xs text-white/35" data-chart-percent>0%</span>
            </div>
            <div class="mt-4 h-2 overflow-hidden rounded-full bg-white/[0.07]">
              <div class="h-full rounded-full bg-gradient-to-r from-omega-300 to-omega-600 transition-all duration-300" style="width: 0%" data-chart-progress-bar></div>
            </div>

            <div class="mt-5 grid grid-cols-5 gap-2 sm:grid-cols-5">
              {% for slot in 1..current_phase.examples_required %}
                <span data-chart-slot class="flex aspect-square items-center justify-center rounded-lg border border-white/10 bg-white/[0.035] font-mono text-xs text-white/35 transition">
                  {{ '%02d'|format(slot) }}
                </span>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      <aside id="assessment" class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 shadow-2xl shadow-black/25">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="font-display text-2xl font-semibold">Phase unlock rule</h2>
            <p class="mt-1 text-sm text-white/45">What opens the next stage.</p>
          </div>
          <i data-lucide="key-round" class="h-5 w-5 text-omega-300"></i>
        </div>

        <div class="mt-5 space-y-3">
          <div class="flex gap-3 rounded-xl border border-omega-400/20 bg-omega-500/10 p-4">
            <i data-lucide="check-circle-2" class="mt-0.5 h-4 w-4 text-omega-300"></i>
            <div>
              <div class="text-sm font-medium text-white/85">Finish all videos</div>
              <p class="mt-1 text-xs leading-relaxed text-white/45">Mark every lesson completed to open chart proof.</p>
            </div>
          </div>
          <div class="flex gap-3 rounded-xl border border-white/10 bg-white/[0.035] p-4">
            <i data-lucide="images" class="mt-0.5 h-4 w-4 text-omega-300"></i>
            <div>
              <div class="text-sm font-medium text-white/85">Upload 15 charts</div>
              <p class="mt-1 text-xs leading-relaxed text-white/45">Submit examples that prove the phase concept is understood.</p>
            </div>
          </div>
          <div class="flex gap-3 rounded-xl border border-white/10 bg-white/[0.035] p-4">
            <i data-lucide="badge-help" class="mt-0.5 h-4 w-4 text-omega-300"></i>
            <div>
              <div class="text-sm font-medium text-white/85">Pass assessment</div>
              <p class="mt-1 text-xs leading-relaxed text-white/45">The phase quiz comes in the next build and controls progression.</p>
            </div>
          </div>
        </div>
      </aside>
    </section>
  </div>
{% endblock %}
